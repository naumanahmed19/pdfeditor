{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PickPDF",
  "version": "0.3.0",
  "identifier": "com.xvelopers.pickpdf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "PickPDF",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "credentialless"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": "26C4327DF20F7C0C47FEE004F22FB1ABF13662CD",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFMzA1Qzk4RTYwN0Y2MDkKUldRSjlnZm1tRnd3enFwZG91WTlFdithbjc4bjFVdWhQUy9pcURkamJySVBidVNuUGdJNnlSRlcK",
      "endpoints": [
        "https://releases.pickpdf.app/stable/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
